{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:design:traceability:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "unleash.design.traceability.v1"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "const": "specification_only"
    },
    "revision": {
      "type": "string",
      "pattern": "^R[0-9]+$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-[A-Z]+-\\d{3}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "architecture": {
            "type": "string",
            "minLength": 1
          },
          "feature_id": {
            "type": "string",
            "pattern": "^F\\d{3}$"
          },
          "feature_path": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_id": {
            "type": "string",
            "pattern": "^AC-F\\d{3}-\\d{3}$"
          },
          "test_id": {
            "type": "string",
            "pattern": "^T-F\\d{3}-\\d{3}$"
          },
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-F\\d{3}-\\d{3}$"
          },
          "evidence_expected": {
            "type": "string",
            "minLength": 1
          },
          "product_test_status": {
            "const": "not_run"
          }
        },
        "required": [
          "requirement_id",
          "requirement",
          "architecture",
          "feature_id",
          "feature_path",
          "acceptance_id",
          "test_id",
          "evidence_id",
          "evidence_expected",
          "product_test_status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "date",
    "scope",
    "revision",
    "requirements"
  ]
}
