{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:ipc-subscribe-events:1",
  "title": "Abonnement aux événements proposé",
  "description": "Requête d'abonnement ou trame d'événements/resync sur le flux SubscribeEvents.",
  "oneOf": [
    {
      "$ref": "#/$defs/SubscribeEventsRequest"
    },
    {
      "$ref": "#/$defs/SubscribeEventsFrame"
    }
  ],
  "$defs": {
    "SubscribeEventsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "after_sequence",
        "batch_limit"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "after_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "aggregate_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "SubscribeEventsFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "events",
            "resync_required"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "urn:ovpt:unleash:event:1"
          }
        },
        "cursor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stream_id",
            "sequence"
          ],
          "properties": {
            "stream_id": {
              "type": "string",
              "format": "uuid"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "current_watermark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stream_id",
            "sequence"
          ],
          "properties": {
            "stream_id": {
              "type": "string",
              "format": "uuid"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "events"
            }
          },
          "required": [
            "kind",
            "events",
            "cursor"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "resync_required"
            }
          },
          "required": [
            "kind",
            "stream_id",
            "current_watermark",
            "reason"
          ]
        }
      ]
    }
  }
}
