{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:ipc-query:1",
  "title": "QueryEnvelope proposée",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "query_type",
    "project_id",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": [
        "unleash.ipc.v2"
      ],
      "description": "Version du protocole IPC (unleash.ipc.v2)."
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "query_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$",
      "maxLength": 96
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "run_list_project_id": {
      "type": "string",
      "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "run_page_cursor": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512,
      "not": { "type": "string", "pattern": "[^A-Za-z0-9_-]" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "query_type": { "const": "GetWorkflowDraft" } } },
      "then": {
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "payload": {
            "type": "object", "additionalProperties": false, "required": ["draft_id"],
            "properties": { "draft_id": { "type": "string", "format": "uuid" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "GetWorkflowValidation" } } },
      "then": {
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["validation_report_id"],
            "properties": { "validation_report_id": { "type": "string", "format": "uuid" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "ListProviderProfiles" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "after_profile_id": {
                "type": ["string", "null"],
                "format": "uuid",
                "not": { "const": "00000000-0000-0000-0000-000000000000" }
              },
              "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_type": {
            "const": "ListWorktrees"
          }
        }
      },
      "then": {
        "properties": {
          "project_id": {
            "$ref": "#/$defs/run_list_project_id"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo_id"
            ],
            "properties": {
              "repo_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "default": 50
              },
              "opaque_cursor": {
                "$ref": "#/$defs/run_page_cursor"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "ListRuns" } } },
      "then": {
        "properties": {
          "project_id": { "$ref": "#/$defs/run_list_project_id" },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "page_size": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
              "opaque_cursor": { "$ref": "#/$defs/run_page_cursor" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_type": {
            "const": "GetRun"
          }
        }
      },
      "then": {
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "GetAgent" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent_id"],
            "properties": { "agent_id": { "type": "string", "format": "uuid" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "GetInvocation" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invocation_id"],
            "properties": {
              "invocation_id": { "type": "string", "format": "uuid" },
              "after_attempt_ordinal": {
                "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0
              },
              "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "query_type": { "const": "GetCommandReceipt" } }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_id"],
            "properties": {
              "command_id": { "type": "string", "format": "uuid" },
              "result_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]" },
                "description": "La limite de 128 octets UTF-8 est également vérifiée par le daemon."
              }
            }
          }
        },
        "if": { "properties": { "payload": { "required": ["result_ref"] } } },
        "then": { "properties": { "project_id": { "type": "string" } } }
      }
    }
  ]
}
