{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:ipc-query:1",
  "title": "QueryEnvelope proposée",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "query_type",
    "project_id",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": [
        "unleash.ipc.v2"
      ],
      "description": "Version du protocole IPC (unleash.ipc.v2)."
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "query_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$",
      "maxLength": 96
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "workflow_draft_artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "draft_id", "revision", "digest", "size_bytes", "media_type"],
      "properties": {
        "kind": { "const": "workflow_draft_revision" },
        "draft_id": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "media_type": { "const": "text/plain; charset=utf-8" }
      }
    },
    "discovery_receipt_artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "receipt_id", "schema_version", "digest", "size_bytes", "media_type"],
      "properties": {
        "kind": { "const": "discovery_receipt" },
        "receipt_id": { "$ref": "urn:ovpt:unleash:discovery-receipt:1#/$defs/canonicalReceiptId" },
        "schema_version": { "const": "unleash.discovery.v1" },
        "digest": { "type": "string", "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "media_type": { "const": "application/json" }
      }
    },
    "read_artifact_block_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "offset_bytes", "limit_bytes"],
      "properties": {
        "artifact_ref": { "type": "object" },
        "offset_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "limit_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "read_workflow_draft_artifact_payload": {
      "$ref": "#/$defs/read_artifact_block_payload",
      "properties": { "artifact_ref": { "$ref": "#/$defs/workflow_draft_artifact_ref" } }
    },
    "read_discovery_receipt_artifact_payload": {
      "$ref": "#/$defs/read_artifact_block_payload",
      "properties": { "artifact_ref": { "$ref": "#/$defs/discovery_receipt_artifact_ref" } }
    },
    "run_list_project_id": {
      "type": "string",
      "format": "uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "discovery_query_result_ref": {
      "type": "string", "minLength": 52, "maxLength": 52,
      "pattern": "^discovery-query:(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "run_page_cursor": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 512,
      "not": { "type": "string", "pattern": "[^A-Za-z0-9_-]" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "query_type": { "const": "GetDiscoveryReceipt" } } },
      "then": {
        "properties": {
          "project_id": { "$ref": "#/$defs/run_list_project_id" },
          "payload": {
            "type": "object", "additionalProperties": false, "required": ["receipt_id"],
            "properties": {
              "receipt_id": { "$ref": "urn:ovpt:unleash:discovery-receipt:1#/properties/receipt_id" },
              "page_size": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
              "opaque_cursor": { "$ref": "#/$defs/run_page_cursor" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "GetWorkflowDraft" } } },
      "then": {
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "payload": {
            "type": "object", "additionalProperties": false, "required": ["draft_id"],
            "properties": { "draft_id": { "type": "string", "format": "uuid" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_type": { "const": "ReadArtifact" },
          "payload": {
            "required": ["artifact_ref"],
            "properties": {
              "artifact_ref": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "workflow_draft_revision" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "payload": { "$ref": "#/$defs/read_workflow_draft_artifact_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_type": { "const": "ReadArtifact" },
          "payload": {
            "required": ["artifact_ref"],
            "properties": {
              "artifact_ref": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "discovery_receipt" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "project_id": { "$ref": "#/$defs/run_list_project_id" },
          "payload": { "$ref": "#/$defs/read_discovery_receipt_artifact_payload" }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "GetWorkflowValidation" } } },
      "then": {
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["validation_report_id"],
            "properties": { "validation_report_id": { "type": "string", "format": "uuid" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "ListProviderProfiles" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "after_profile_id": {
                "type": ["string", "null"],
                "format": "uuid",
                "not": { "const": "00000000-0000-0000-0000-000000000000" }
              },
              "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_type": {
            "const": "ListWorktrees"
          }
        }
      },
      "then": {
        "properties": {
          "project_id": {
            "$ref": "#/$defs/run_list_project_id"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo_id"
            ],
            "properties": {
              "repo_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "page_size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "default": 50
              },
              "opaque_cursor": {
                "$ref": "#/$defs/run_page_cursor"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "ListRuns" } } },
      "then": {
        "properties": {
          "project_id": { "$ref": "#/$defs/run_list_project_id" },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "page_size": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
              "opaque_cursor": { "$ref": "#/$defs/run_page_cursor" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "query_type": {
            "const": "GetRun"
          }
        }
      },
      "then": {
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "GetAgent" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent_id"],
            "properties": { "agent_id": { "type": "string", "format": "uuid" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "query_type": { "const": "GetInvocation" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invocation_id"],
            "properties": {
              "invocation_id": { "type": "string", "format": "uuid" },
              "after_attempt_ordinal": {
                "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0
              },
              "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "query_type": { "const": "GetCommandReceipt" } }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_id"],
            "properties": {
              "command_id": { "type": "string", "format": "uuid" },
              "result_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]" },
                "description": "La limite de 128 octets UTF-8 est également vérifiée par le daemon."
              }
            }
          }
        },
        "if": { "properties": { "payload": { "required": ["result_ref"] } } },
        "then": {
          "properties": { "project_id": { "type": "string" } },
          "if": { "properties": { "payload": { "properties": { "result_ref": { "pattern": "^discovery-query:" } } } } },
          "then": {
            "properties": {
              "project_id": { "$ref": "#/$defs/run_list_project_id" },
              "payload": { "properties": { "result_ref": { "$ref": "#/$defs/discovery_query_result_ref" } } }
            }
          }
        }
      }
    }
  ]
}
