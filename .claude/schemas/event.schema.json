{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:event:1",
  "title": "Événement durable proposé",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "stream_id",
    "sequence",
    "event_type",
    "schema_version",
    "occurred_at",
    "recorded_at",
    "project_id",
    "aggregate_id",
    "aggregate_revision",
    "actor_ref",
    "correlation_id",
    "causation",
    "command_id",
    "payload_hash",
    "payload",
    "sensitivity"
  ],
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "InvocationStarted" } } },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attempt_id", "reservation_id", "lease_id", "authority_generation", "daemon_epoch",
                  "fence", "prepared_sequence", "context_manifest_id", "context_manifest_digest",
                  "scope_id", "scope_revision", "process_identity"
                ],
                "properties": {
                  "attempt_id": { "type": "string", "format": "uuid" },
                  "reservation_id": { "type": "string", "format": "uuid" },
                  "lease_id": { "type": "string", "format": "uuid" },
                  "authority_generation": { "type": "string", "format": "uuid" },
                  "daemon_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                  "fence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                  "prepared_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                  "context_manifest_id": { "type": "string", "format": "uuid" },
                  "context_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "scope_id": { "type": "string", "minLength": 1 },
                  "scope_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "process_identity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["pid", "owner_uid", "boot_identity", "start_identity"],
                    "properties": {
                      "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                      "owner_uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                      "boot_identity": { "type": "string", "minLength": 1 },
                      "start_identity": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              },
              { "const": { "tombstoned": true } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "InvocationWorkerLaunchPrepared" } } },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attempt_id", "reservation_id", "lease_id", "authority_generation", "daemon_epoch",
                  "fence", "context_manifest_id", "context_manifest_digest", "scope_id", "scope_revision"
                ],
                "properties": {
                  "attempt_id": { "type": "string", "format": "uuid" },
                  "reservation_id": { "type": "string", "format": "uuid" },
                  "lease_id": { "type": "string", "format": "uuid" },
                  "authority_generation": { "type": "string", "format": "uuid" },
                  "daemon_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                  "fence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                  "context_manifest_id": { "type": "string", "format": "uuid" },
                  "context_manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "scope_id": { "type": "string", "minLength": 1 },
                  "scope_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                }
              },
              { "const": { "tombstoned": true } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "ActionObserved" } } },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "terminal_resize": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command_id", "receipt_id", "terminal_id", "process_run_uuid", "dimensions", "lease_expires_at"],
                "properties": {
                  "command_id": { "type": "string", "format": "uuid" },
                  "receipt_id": { "type": "string", "format": "uuid" },
                  "terminal_id": { "type": "string", "format": "uuid" },
                  "process_run_uuid": { "type": "string", "format": "uuid" },
                  "dimensions": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["rows", "cols"],
                    "properties": {
                      "rows": { "type": "integer", "minimum": 1, "maximum": 500 },
                      "cols": { "type": "integer", "minimum": 1, "maximum": 1000 }
                    }
                  },
                  "lease_expires_at": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "TerminalControlDispatchRefused" } } },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["action_id", "command_id", "receipt_id", "terminal_id", "context_digest", "reason", "operation"],
                "properties": {
                  "action_id": { "type": "string", "format": "uuid" },
                  "command_id": { "type": "string", "format": "uuid" },
                  "receipt_id": { "type": "string", "format": "uuid" },
                  "terminal_id": { "type": "string", "format": "uuid" },
                  "context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "reason": { "enum": ["daemon_superseded", "policy_changed", "authorization_denied"] },
                  "operation": { "enum": ["renewal", "resize"] }
                }
              },
              { "const": { "tombstoned": true } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "ProviderProbeDispatchRefused" } } },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["schema_version", "probe_id", "action_id", "evaluation_id", "intent_digest", "reason", "disposition_digest", "reservation_id", "lease_id", "fence"],
                "properties": {
                  "schema_version": { "const": 1 },
                  "probe_id": { "type": "string", "format": "uuid" },
                  "action_id": { "type": "string", "format": "uuid" },
                  "evaluation_id": { "type": "string", "format": "uuid" },
                  "intent_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "reason": { "enum": ["policy_changed", "authorization_denied"] },
                  "disposition_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  "reservation_id": { "type": "string", "format": "uuid" },
                  "lease_id": { "type": "string", "format": "uuid" },
                  "fence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
                }
              },
              { "const": { "tombstoned": true } }
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "stream_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$"
    },
    "schema_version": {
      "const": 1,
      "description": "Version de l'enveloppe. La version d'un payload est portée par event_type : un changement incompatible crée un nouveau type."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "actor_ref": {
      "type": "string",
      "maxLength": 256
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "event",
            "action",
            "timer",
            "external"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 256
        }
      },
      "description": "Cause typée : kind=command implique id=receipt_id global serveur, résolu vers acteur+command_id ; jamais command_id brut à portée d'acteur."
    },
    "command_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "description": "Payload borné porté inline ; un contenu volumineux y figure comme référence adressée par contenu. L'enveloppe n'a pas de champ payload_ref."
    },
    "sensitivity": {
      "enum": [
        "public",
        "project",
        "confidential",
        "restricted"
      ]
    }
  }
}

