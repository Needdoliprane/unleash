{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:ipc-command:2",
  "title": "CommandEnvelope v2 proposée",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "command_id",
    "authority_generation",
    "actor_ref",
    "project_id",
    "aggregate_id",
    "expected_revision",
    "command_type",
    "payload"
  ],
  "$defs": {
    "terminal_release_reconcile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "terminal_id",
        "process_run_uuid",
        "source_action_id",
        "source_dispatch_id"
      ],
      "properties": {
        "kind": {
          "const": "attest_terminal_release"
        },
        "terminal_id": {
          "type": "string",
          "format": "uuid"
        },
        "process_run_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "source_action_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_dispatch_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "terminal_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_id",
        "process_run_uuid",
        "lease_id",
        "fence"
      ],
      "properties": {
        "terminal_id": {
          "type": "string",
          "format": "uuid"
        },
        "process_run_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "lease_id": {
          "type": "string",
          "format": "uuid"
        },
        "fence": {
          "$ref": "#/$defs/wire_unsigned_integer",
          "minimum": 1
        }
      }
    },
    "terminal_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_id", "process_run_uuid", "lease_id", "fence", "input_seq", "payload_bytes"],
      "properties": {
        "terminal_id": { "type": "string", "format": "uuid" },
        "process_run_uuid": { "type": "string", "format": "uuid" },
        "lease_id": { "type": "string", "format": "uuid" },
        "fence": { "$ref": "#/$defs/wire_unsigned_integer", "minimum": 1 },
        "input_seq": { "$ref": "#/$defs/wire_unsigned_integer", "minimum": 1 },
        "payload_bytes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "terminal_resize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_id", "process_run_uuid", "lease_id", "fence", "rows", "cols"],
      "properties": {
        "terminal_id": { "type": "string", "format": "uuid" },
        "process_run_uuid": { "type": "string", "format": "uuid" },
        "lease_id": { "type": "string", "format": "uuid" },
        "fence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 500 },
        "cols": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "registered_terminal_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_id", "process_run_uuid", "scope_revision", "control_mode"],
      "properties": {
        "terminal_id": { "type": "string", "format": "uuid" },
        "process_run_uuid": { "type": "string", "format": "uuid" },
        "scope_revision": { "$ref": "#/$defs/wire_unsigned_integer" },
        "control_mode": { "const": "exclusive" }
      }
    },
    "new_terminal_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id", "purpose_key", "reuse_policy", "scope_id", "scope_revision", "cwd", "program",
        "arguments", "environment_profile_id", "pty", "readiness"
      ],
      "properties": {
        "mission_id": { "type": "string", "format": "uuid" },
        "invocation_id": { "type": ["string", "null"], "format": "uuid" },
        "purpose_key": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reuse_policy": { "enum": ["reuse_compatible", "new_required"] },
        "reuse_justification": { "type": "string", "maxLength": 256, "pattern": "\\S" },
        "scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "scope_revision": { "$ref": "#/$defs/wire_unsigned_integer" },
        "worktree_id": { "type": ["string", "null"], "format": "uuid" },
        "cwd": { "type": "string", "minLength": 1 },
        "program": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "environment_profile_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "pty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "cols"],
          "properties": {
            "rows": { "type": "integer", "minimum": 1, "maximum": 500 },
            "cols": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timeout_ms"],
          "properties": {
            "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
            "timeout_ms": { "$ref": "#/$defs/wire_unsigned_integer", "minimum": 1 }
          }
        }
      },
      "if": { "properties": { "reuse_policy": { "const": "new_required" } } },
      "then": { "required": ["reuse_justification"] },
      "else": { "not": { "required": ["reuse_justification"] } }
    },
    "terminal_runtime_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profiles", "max_hosts", "max_processes", "max_ptys", "lease_ttl_ms"],
      "properties": {
        "schema_version": { "const": 1 },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile_id", "version", "variables"],
            "properties": {
              "profile_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]",
                "not": { "pattern": "[^a-z0-9._-]" }
              },
              "version": { "$ref": "#/$defs/wire_unsigned_integer", "minimum": 1 },
              "variables": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "LANG": { "enum": ["C", "C.UTF-8", "en_US.UTF-8", "fr_FR.UTF-8"] },
                  "LC_ALL": { "enum": ["C", "C.UTF-8", "en_US.UTF-8", "fr_FR.UTF-8"] },
                  "TERM": { "enum": ["xterm", "xterm-256color", "vt100", "dumb"] },
                  "TZ": { "const": "UTC" }
                }
              }
            }
          }
        },
        "max_hosts": { "type": "integer", "minimum": 1, "maximum": 50 },
        "max_processes": { "type": "integer", "minimum": 1, "maximum": 50 },
        "max_ptys": { "type": "integer", "minimum": 1, "maximum": 50 },
        "lease_ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    },
    "wire_unsigned_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "probe_reference": {
      "type": "string",
      "maxLength": 256,
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]" },
      "description": "Chaîne avec au moins un caractère hors White_Space Unicode et sans caractère de contrôle. Le décodeur applique la limite de 256 octets UTF-8."
    },
    "probe_capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/probe_reference" }
    },
    "probe_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_calls", "max_output_tokens", "max_cost_usd_micros"],
      "properties": {
        "timeout_ms": { "$ref": "#/$defs/wire_unsigned_integer", "minimum": 1 },
        "max_calls": { "$ref": "#/$defs/wire_unsigned_integer" },
        "max_output_tokens": { "$ref": "#/$defs/wire_unsigned_integer" },
        "max_cost_usd_micros": { "$ref": "#/$defs/wire_unsigned_integer" }
      }
    },
    "provider_probe_mandate_change": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind", "principal_id", "profile_id", "profile_version", "phase", "locality",
            "capability_set", "limits", "expires_at_ms"
          ],
          "properties": {
            "kind": { "const": "issue" },
            "principal_id": { "$ref": "#/$defs/probe_reference" },
            "profile_id": { "type": "string", "format": "uuid" },
            "profile_version": { "$ref": "#/$defs/wire_unsigned_integer", "minimum": 1 },
            "phase": { "enum": ["connect", "inventory", "generation_probe"] },
            "locality": { "enum": ["local_only", "approved_remote"] },
            "capability_set": { "$ref": "#/$defs/probe_capabilities" },
            "limits": { "$ref": "#/$defs/probe_limits" },
            "expires_at_ms": { "$ref": "#/$defs/wire_unsigned_integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mandate_ref"],
          "properties": {
            "kind": { "const": "revoke" },
            "mandate_ref": { "type": "string", "format": "uuid" }
          }
        }
      ]
    },
    "set_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_id", "isolation_mode", "policy_version", "reason"],
      "properties": {
        "scope_kind": { "enum": ["global", "project"] },
        "scope_id": { "type": "string" },
        "isolation_mode": { "enum": ["standard", "strict"] },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "provider_probe_mandate": { "$ref": "#/$defs/provider_probe_mandate_change" }
      },
      "if": { "properties": { "scope_kind": { "const": "global" } } },
      "then": { "properties": { "scope_id": { "const": "global" } } },
      "else": { "properties": { "scope_id": { "format": "uuid" } } }
    },
    "test_provider_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "phase", "capability_set", "limits", "locality", "mandate_ref"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/probe_reference" },
        "profile_version": { "$ref": "#/$defs/wire_unsigned_integer", "minimum": 1 },
        "phase": { "enum": ["validate_config", "connect", "inventory", "generation_probe"] },
        "capability_set": { "$ref": "#/$defs/probe_capabilities" },
        "limits": { "$ref": "#/$defs/probe_limits" },
        "locality": { "enum": ["local_only", "approved_remote"] },
        "mandate_ref": { "$ref": "#/$defs/probe_reference" }
      },
      "if": { "properties": { "phase": { "const": "generation_probe" } } },
      "then": {
        "properties": {
          "limits": {
            "properties": {
              "timeout_ms": { "maximum": 60000 },
              "max_calls": { "minimum": 1, "maximum": 3 },
              "max_output_tokens": { "minimum": 1, "maximum": 512 },
              "max_cost_usd_micros": { "maximum": 100000 }
            }
          }
        }
      }
    },
    "provider_positive_integer": {
      "$ref": "#/$defs/wire_unsigned_integer",
      "minimum": 1
    },
    "provider_endpoint": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https?://[^/?#@]+(?:/(?:[^%?#]|%[0-9A-Fa-f]{2})*)?$",
      "not": { "pattern": "[^!-~]|\\\\" },
      "description": "URL ASCII sans identifiants, requête ni fragment. Le décodeur vérifie l'hôte et le port et restreint HTTP au loopback."
    },
    "provider_digest": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64 },
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "minLength": 71, "maxLength": 71 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "hex"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "hex": { "type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64 }
          }
        }
      ]
    },
    "provider_optional_amount": {
      "anyOf": [{ "$ref": "#/$defs/wire_unsigned_integer" }, { "type": "null" }]
    },
    "provider_inline_price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency", "input_micros_per_million", "cached_input_micros_per_million",
        "cache_write_micros_per_million", "output_micros_per_million", "observed_at_ms",
        "valid_until_ms", "source_url"
      ],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "minLength": 3, "maxLength": 3 },
        "input_micros_per_million": { "$ref": "#/$defs/provider_optional_amount" },
        "cached_input_micros_per_million": { "$ref": "#/$defs/provider_optional_amount" },
        "cache_write_micros_per_million": { "$ref": "#/$defs/provider_optional_amount" },
        "output_micros_per_million": { "$ref": "#/$defs/provider_optional_amount" },
        "observed_at_ms": { "$ref": "#/$defs/wire_unsigned_integer" },
        "valid_until_ms": { "$ref": "#/$defs/wire_unsigned_integer" },
        "source_url": { "anyOf": [{ "$ref": "#/$defs/provider_endpoint" }, { "type": "null" }] }
      },
      "description": "Tarif inline sans paliers. Le décodeur compare la date du constat à la date limite."
    },
    "set_provider_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_kind", "dialect", "endpoint", "model", "locality", "server_management",
        "auth", "limits", "declared_capabilities", "pricing"
      ],
      "properties": {
        "provider_kind": { "enum": ["openai", "anthropic", "lmstudio", "ollama", "llama_cpp", "openai_compatible"] },
        "dialect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version"],
          "properties": {
            "kind": { "enum": ["openai_responses", "anthropic_messages", "openai_chat_completions", "ollama_chat"] },
            "version": { "$ref": "#/$defs/provider_positive_integer" }
          }
        },
        "endpoint": { "$ref": "#/$defs/provider_endpoint" },
        "model": { "$ref": "#/$defs/probe_reference" },
        "locality": { "enum": ["local_only", "approved_remote"] },
        "server_management": { "enum": ["user_managed", "unleash_managed"] },
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "none" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "secret_ref"],
              "properties": {
                "kind": { "const": "secret_ref" },
                "secret_ref": { "$ref": "#/$defs/probe_reference" }
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_inflight", "connect_timeout_ms", "queue_timeout_ms", "load_timeout_ms",
            "first_token_timeout_ms", "generation_timeout_ms"
          ],
          "properties": {
            "max_inflight": { "$ref": "#/$defs/provider_positive_integer" },
            "connect_timeout_ms": { "$ref": "#/$defs/provider_positive_integer" },
            "queue_timeout_ms": { "$ref": "#/$defs/provider_positive_integer" },
            "load_timeout_ms": { "$ref": "#/$defs/provider_positive_integer" },
            "first_token_timeout_ms": { "$ref": "#/$defs/provider_positive_integer" },
            "generation_timeout_ms": { "$ref": "#/$defs/provider_positive_integer" }
          }
        },
        "declared_capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/probe_reference" }
        },
        "pricing": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "none_local" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "catalog_id", "catalog_version", "catalog_digest", "entry_digest", "stale_policy"],
              "properties": {
                "kind": { "const": "catalog" },
                "catalog_id": { "$ref": "#/$defs/probe_reference" },
                "catalog_version": { "$ref": "#/$defs/probe_reference" },
                "catalog_digest": { "$ref": "#/$defs/provider_digest" },
                "entry_digest": { "$ref": "#/$defs/provider_digest" },
                "stale_policy": { "enum": ["block", "warn"] }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "entry", "stale_policy"],
              "properties": {
                "kind": { "enum": ["user_import", "user_declared"] },
                "entry": { "$ref": "#/$defs/provider_inline_price" },
                "stale_policy": { "enum": ["block", "warn"] }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "provider_kind": { "const": "openai" } } },
          "then": { "properties": { "dialect": { "properties": { "kind": { "const": "openai_responses" } } } } }
        },
        {
          "if": { "properties": { "provider_kind": { "const": "anthropic" } } },
          "then": { "properties": { "dialect": { "properties": { "kind": { "const": "anthropic_messages" } } } } }
        },
        {
          "if": { "properties": { "provider_kind": { "enum": ["lmstudio", "llama_cpp"] } } },
          "then": { "properties": { "dialect": { "properties": { "kind": { "const": "openai_chat_completions" } } } } }
        },
        {
          "if": { "properties": { "provider_kind": { "const": "ollama" } } },
          "then": { "properties": { "dialect": { "properties": { "kind": { "const": "ollama_chat" } } } } }
        },
        {
          "if": { "properties": { "provider_kind": { "const": "openai_compatible" } } },
          "then": {
            "properties": {
              "dialect": { "properties": { "kind": { "enum": ["openai_responses", "openai_chat_completions"] } } }
            }
          }
        },
        {
          "if": { "properties": { "provider_kind": { "enum": ["openai", "anthropic"] } } },
          "then": {
            "properties": {
              "auth": { "properties": { "kind": { "const": "secret_ref" } } },
              "pricing": { "properties": { "kind": { "not": { "const": "none_local" } } } }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "ReconcileProcess"
          }
        }
      },
      "then": {
        "required": [
          "project_id"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {
            "$ref": "#/$defs/terminal_release_reconcile"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "ReleaseTerminal"
          }
        }
      },
      "then": {
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {
            "$ref": "#/$defs/terminal_release"
          }
        }
      }
    },
    {
      "if": { "properties": { "command_type": { "const": "SetPolicy" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/set_policy" } } }
    },
    {
      "if": { "properties": { "command_type": { "const": "TestProviderProfile" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/test_provider_profile" } } }
    },
    {
      "if": { "properties": { "command_type": { "const": "SetProviderProfile" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/set_provider_profile" } } }
    },
    {
      "if": { "properties": { "command_type": { "const": "AcquireTerminal" } } },
      "then": {
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "payload": {
            "oneOf": [
              { "$ref": "#/$defs/new_terminal_allocation" },
              { "$ref": "#/$defs/registered_terminal_control" }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "command_type": { "const": "SendTerminalInput" } } },
      "then": {
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "payload": { "$ref": "#/$defs/terminal_input" }
        }
      }
    },
    {
      "if": { "properties": { "command_type": { "const": "ResizeTerminal" } } },
      "then": {
        "properties": {
          "project_id": { "type": "string", "format": "uuid" },
          "payload": { "$ref": "#/$defs/terminal_resize" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": { "const": "SetSettings" },
          "payload": {
            "required": ["patch"],
            "properties": {
              "patch": { "type": "object", "required": ["terminal_runtime"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "project_id": { "type": "null" },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope_kind", "scope_id", "patch"],
            "properties": {
              "scope_kind": { "const": "user" },
              "scope_id": { "const": "default" },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "execution_pool": true,
                  "retention_policy": true,
                  "confirm_retention_shortening": true,
                  "analyzer_paths": true,
                  "terminal_runtime": { "$ref": "#/$defs/terminal_runtime_settings" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "protocol_version": {
      "const": "unleash.ipc.v2"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "authority_generation": {
      "type": "string",
      "format": "uuid",
      "description": "Lignée serveur épinglée lors de la création durable de la commande ; incluse au digest et conservée lors de tout retry, même après reconnexion. Une autre lignée est refusée avant recherche du receipt."
    },
    "actor_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "description": "Identité résolue par serveur ; champ client non fiable"
