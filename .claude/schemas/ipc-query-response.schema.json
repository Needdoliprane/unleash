{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:ipc-query-response:1",
  "title": "QueryResponse proposée",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "result"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "watermark": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "stream_id",
        "sequence"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Watermark transactionnel optionnel de la vue projetée (stream_id et sequence)."
    },
    "result": {
      "description": "Données ou objet de résultat de la requête."
    }
  },
  "$defs": {
    "discovery_receipt_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object", "additionalProperties": false,
          "required": ["project_id", "current_freshness", "use_state", "history"],
          "oneOf": [
            { "required": ["receipt"] },
            { "required": ["receipt_artifact"] }
          ],
          "properties": {
            "project_id": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/run_list_project_id" },
            "receipt": { "$ref": "urn:ovpt:unleash:discovery-receipt:1" },
            "receipt_artifact": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/discovery_receipt_artifact_ref" },
            "current_freshness": { "enum": ["valid", "stale", "unknown"] },
            "use_state": { "enum": ["unused", "authorized", "consumed", "outcome_unknown"] },
            "history": {
              "type": "object", "additionalProperties": false,
              "required": ["items", "coverage", "next_cursor"],
              "properties": {
                "items": {
                  "type": "array", "maxItems": 100,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["event_id", "event_type", "stream_id", "sequence"],
                    "properties": {
                      "event_id": { "$ref": "urn:ovpt:unleash:event:1#/properties/event_id" },
                      "event_type": { "enum": ["DiscoveryReceiptInvalidated", "DiscoveryValidationObserved"] },
                      "stream_id": { "$ref": "urn:ovpt:unleash:event:1#/properties/stream_id" },
                      "sequence": { "$ref": "urn:ovpt:unleash:event:1#/properties/sequence" }
                    }
                  }
                },
                "coverage": {
                  "type": "object", "additionalProperties": false, "required": ["status"],
                  "properties": { "status": { "enum": ["complete", "incomplete"] } }
                },
                "next_cursor": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/run_page_cursor" }
              }
            }
          }
        }
      }
    },
    "worktree_branch_ref": {"type": "string", "pattern": "^refs/heads/.+", "not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"}},
    "worktree_list_response": {
      "$ref": "#",
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "repo_id",
            "object_format",
            "git_profile_digest",
            "observed_at",
            "items",
            "coverage",
            "next_cursor"
          ],
          "properties": {
            "project_id": {"$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/run_list_project_id"},
            "repo_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "object_format": {"enum": ["sha1", "sha256"]},
            "git_profile_digest": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
            "observed_at": {"type": "string", "format": "date-time"},
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "not": {
                  "required": ["head_oid", "branch_ref"],
                  "properties": {"head_oid": {"type": "null"}, "branch_ref": {"type": "null"}}
                },
                "required": [
                  "path",
                  "head_oid",
                  "branch_ref",
                  "dirty",
                  "operations",
                  "operations_complete",
                  "operation_branches",
                  "operation_branches_complete",
                  "ownership"
                ],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "head_oid": {
                    "oneOf": [
                      {"type": "null"},
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["format", "hex"],
                        "properties": {
                          "format": {"const": "sha1"},
                          "hex": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$"}
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["format", "hex"],
                        "properties": {
                          "format": {"const": "sha256"},
                          "hex": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
                        }
                      }
                    ]
                  },
                  "branch_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/worktree_branch_ref"}]},
                  "dirty": {"enum": ["clean", "dirty", "unknown"]},
                  "operations": {
                    "type": "array",
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {"enum": ["merge", "rebase", "bisect", "cherry_pick"]}
                  },
                  "operations_complete": {"type": "boolean"},
                  "operation_branches": {
                    "type": "array",
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["operation", "branch_ref", "provenance"],
                      "properties": {
                        "operation": {"enum": ["rebase", "bisect"]},
                        "branch_ref": {"$ref": "#/$defs/worktree_branch_ref"},
                        "provenance": {"enum": ["rebase_metadata", "bisect_metadata"]}
                      },
                      "oneOf": [
                        {
                          "properties": {"operation": {"const": "rebase"}, "provenance": {"const": "rebase_metadata"}}
                        },
                        {
                          "properties": {"operation": {"const": "bisect"}, "provenance": {"const": "bisect_metadata"}}
                        }
                      ]
                    }
                  },
                  "operation_branches_complete": {"type": "boolean"},
                  "ownership": {"enum": ["managed", "external", "unknown"]}
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "operations": {"contains": {"const": "rebase"}},
                        "operation_branches_complete": {"const": true}
                      }
                    },
                    "then": {
                      "properties": {
                        "operation_branches": {
                          "contains": {"properties": {"operation": {"const": "rebase"}}, "required": ["operation"]}
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "operation_branches": {
                          "contains": {"properties": {"operation": {"const": "rebase"}}, "required": ["operation"]}
                        }
                      }
                    },
                    "then": {"properties": {"operations": {"contains": {"const": "rebase"}}}}
                  },
                  {
                    "if": {
                      "properties": {
                        "operations": {"contains": {"const": "bisect"}},
                        "operation_branches_complete": {"const": true}
                      }
                    },
                    "then": {
                      "properties": {
                        "operation_branches": {
                          "contains": {"properties": {"operation": {"const": "bisect"}}, "required": ["operation"]}
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "operation_branches": {
                          "contains": {"properties": {"operation": {"const": "bisect"}}, "required": ["operation"]}
                        }
                      }
                    },
                    "then": {"properties": {"operations": {"contains": {"const": "bisect"}}}}
                  }
                ]
              }
            },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {"status": {"enum": ["complete", "incomplete"]}}
            },
            "next_cursor": {"$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/run_page_cursor"}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "items": {
                    "contains": {
                      "anyOf": [
                        {"properties": {"dirty": {"const": "unknown"}}, "required": ["dirty"]},
                        {
                          "properties": {"operations_complete": {"const": false}},
                          "required": ["operations_complete"]
                        },
                        {
                          "properties": {"operation_branches_complete": {"const": false}},
                          "required": ["operation_branches_complete"]
                        }
                      ]
                    }
                  }
                }
              },
              "then": {"properties": {"coverage": {"properties": {"status": {"const": "incomplete"}}}}}
            },
            {
              "if": {"properties": {"items": {"maxItems": 0}}},
              "then": {"properties": {"next_cursor": {"type": "null"}}}
            },
            {
              "if": {"properties": {"object_format": {"const": "sha1"}}},
              "then": {
                "properties": {
                  "items": {
                    "items": {
                      "properties": {
                        "head_oid": {
                          "anyOf": [
                            {"type": "null"},
                            {"properties": {"format": {"const": "sha1"}}, "required": ["format"]}
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {"properties": {"object_format": {"const": "sha256"}}},
              "then": {
                "properties": {
                  "items": {
                    "items": {
                      "properties": {
                        "head_oid": {
                          "anyOf": [
                            {"type": "null"},
                            {"properties": {"format": {"const": "sha256"}}, "required": ["format"]}
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "workflow_text_draft_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object", "additionalProperties": false,
          "required": ["project_id", "draft_id", "revision", "text", "text_hash"],
          "properties": {
            "project_id": { "type": "string", "format": "uuid" },
            "draft_id": { "type": "string", "format": "uuid" },
            "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "text": {
              "type": "string", "maxLength": 1048576,
              "description": "Au plus 1048576 octets UTF-8 après décodage, vérifiés par le daemon."
            },
            "text_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "workflow_draft_response": {
      "oneOf": [
        { "$ref": "#/$defs/workflow_text_draft_response" },
        { "$ref": "#/$defs/workflow_version_draft_response" }
      ]
    },
    "workflow_version_draft_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object", "additionalProperties": false,
          "required": ["project_id", "draft_id", "revision", "text_hash", "base_version", "text_artifact"],
          "properties": {
            "project_id": { "$ref": "#/$defs/uuid" },
            "draft_id": { "$ref": "#/$defs/uuid" },
            "revision": { "$ref": "#/$defs/wire_uint", "minimum": 1 },
            "text_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "base_version": { "$ref": "urn:ovpt:unleash:ipc-command:2#/$defs/create_operational_run/properties/source" },
            "text_artifact": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/workflow_draft_artifact_ref" }
          }
        }
      }
    },
    "artifact_block_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object", "additionalProperties": false,
          "required": ["project_id", "artifact_ref", "offset_bytes", "data_base64", "next_offset_bytes"],
          "properties": {
            "project_id": { "$ref": "#/$defs/uuid" },
            "artifact_ref": { "type": "object" },
            "offset_bytes": { "$ref": "#/$defs/wire_uint" },
            "data_base64": {
              "type": "string", "contentEncoding": "base64", "maxLength": 1398104,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "next_offset_bytes": { "oneOf": [{ "$ref": "#/$defs/wire_uint" }, { "type": "null" }] }
          }
        }
      }
    },
    "workflow_draft_artifact_response": {
      "$ref": "#/$defs/artifact_block_response",
      "properties": {
        "result": {
          "properties": {
            "artifact_ref": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/workflow_draft_artifact_ref" }
          }
        }
      }
    },
    "discovery_receipt_artifact_response": {
      "$ref": "#/$defs/artifact_block_response",
      "properties": {
        "result": {
          "properties": {
            "project_id": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/run_list_project_id" },
            "artifact_ref": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/discovery_receipt_artifact_ref" }
          }
        }
      }
    },
    "workflow_validation_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "pointer", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "pointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" },
        "message": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "source_span_ref": { "type": "string", "minLength": 1 },
        "related_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "suggestion": { "type": "string", "minLength": 1 }
      }
    },
    "workflow_validation_error_diagnostic": {
      "properties": { "severity": { "const": "error" } },
      "required": ["severity"]
    },
    "workflow_validation_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_upper_bound", "max_step_activations", "max_agent_executions",
        "max_concurrent_action_executions"
      ],
      "properties": {
        "activation_upper_bound": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_step_activations": {
          "$ref": "urn:ovpt:unleash:workflow:1.2#/properties/budget/properties/max_step_activations"
        },
        "max_agent_executions": {
          "$ref": "urn:ovpt:unleash:workflow:1.2#/properties/budget/properties/max_agent_executions"
        },
        "max_concurrent_action_executions": {
          "$ref": "urn:ovpt:unleash:workflow:1.2#/properties/budget/properties/max_concurrent_action_executions"
        }
      }
    },
    "workflow_validation_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "project_id", "validation_report_id", "draft_id", "draft_revision",
            "draft_digest", "catalogue_snapshot_ref", "compiler_version", "workflow_profile", "status",
            "diagnostics", "diagnostics_truncated", "bounds", "required_capabilities"
          ],
          "properties": {
            "schema_version": { "const": 1 },
            "project_id": { "$ref": "#/$defs/uuid" },
            "validation_report_id": { "$ref": "#/$defs/uuid" },
            "draft_id": { "$ref": "#/$defs/uuid" },
            "draft_revision": { "$ref": "#/$defs/wire_uint", "minimum": 1 },
            "draft_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "catalogue_snapshot_ref": {
              "$ref": "urn:ovpt:unleash:ipc-command:2#/$defs/workflow_catalogue_snapshot_ref"
            },
            "compiler_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "workflow_profile": {
              "enum": [null, "unleash.workflow.v1", "unleash.workflow.v1.1", "unleash.workflow.v1.2"]
            },
            "status": { "enum": ["valid", "invalid"] },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/workflow_validation_diagnostic" }
            },
            "diagnostics_truncated": { "type": "boolean" },
            "bounds": {
              "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/workflow_validation_bounds" }]
            },
            "required_capabilities": {
              "type": ["array", "null"],
              "uniqueItems": true,
              "items": { "$ref": "urn:ovpt:unleash:role:1#/properties/requested_capabilities/items" }
            },
            "normalized_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "if": { "properties": { "status": { "const": "valid" } } },
          "then": {
            "required": ["normalized_digest"],
            "properties": {
              "diagnostics": { "not": { "contains": { "$ref": "#/$defs/workflow_validation_error_diagnostic" } } },
              "workflow_profile": { "type": "string" },
              "bounds": { "type": "object" },
              "required_capabilities": { "type": "array" }
            }
          },
          "else": {
            "properties": {
              "normalized_digest": false,
              "diagnostics": { "contains": { "$ref": "#/$defs/workflow_validation_error_diagnostic" } }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "workflow_profile": { "const": "unleash.workflow.v1" } } },
              "then": {
                "properties": {
                  "bounds": {
                    "properties": {
                      "max_agent_executions": { "minimum": 1 },
                      "max_concurrent_action_executions": { "const": 0 }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "workflow_run_projection_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "project_id",
        "mission_id",
        "workflow_version_id",
        "definition_hash",
        "effective_bundle_hash",
        "state",
        "revision",
        "purpose",
        "plan"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "mission_id": {
          "type": "string",
          "format": "uuid"
        },
        "workflow_version_id": {
          "type": "string",
          "minLength": 1
        },
        "definition_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effective_bundle_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "prepared",
            "running",
            "paused",
            "blocked",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purpose": {
          "enum": [
            "operational",
            "evaluation"
          ]
        },
        "plan": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "workflow_run_list_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "mission_id", "workflow_version_id", "state", "revision", "purpose"],
      "properties": {
        "run_id": { "$ref": "#/$defs/workflow_run_projection_response/properties/run_id" },
        "mission_id": { "$ref": "#/$defs/workflow_run_projection_response/properties/mission_id" },
        "workflow_version_id": { "$ref": "#/$defs/workflow_run_projection_response/properties/workflow_version_id" },
        "state": { "$ref": "#/$defs/workflow_run_projection_response/properties/state" },
        "revision": { "$ref": "#/$defs/workflow_run_projection_response/properties/revision" },
        "purpose": { "$ref": "#/$defs/workflow_run_projection_response/properties/purpose" }
      }
    },
    "workflow_run_list_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "items", "next_cursor", "coverage"],
          "properties": {
            "project_id": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/run_list_project_id" },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/workflow_run_list_entry" }
            },
            "next_cursor": { "$ref": "urn:ovpt:unleash:ipc-query:1#/$defs/run_page_cursor" },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": { "status": { "const": "complete" } }
            }
          },
          "if": { "properties": { "items": { "maxItems": 0 } } },
          "then": { "properties": { "next_cursor": { "type": "null" } } }
        }
      }
    },
    "uuid": { "type": "string", "format": "uuid" },
    "wire_uint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "optional_uuid": { "type": ["string", "null"], "format": "uuid" },
    "provider_profile_id": {
      "$ref": "#/$defs/uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "read_settings_model_policies_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "required": ["scope_kind", "scope_id", "revision", "model_policy_versions"],
          "properties": {
            "scope_kind": { "enum": ["user", "project"] },
            "scope_id": { "type": "string" },
            "revision": { "$ref": "#/$defs/wire_uint" },
            "model_policy_versions": {
              "type": "array",
              "items": { "$ref": "#/$defs/model_policy_version_projection" }
            }
          },
          "if": { "properties": { "scope_kind": { "const": "user" } } },
          "then": { "properties": { "scope_id": { "const": "default" } } },
          "else": { "properties": { "scope_id": { "$ref": "#/$defs/uuid" } } }
        }
      }
    },
    "model_policy_version_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "version", "digest", "policy_version_ref",
        "allowed_profiles", "allowed_capabilities", "fallback_profiles", "limits",
        "principal_id", "command_receipt_id", "revocation"
      ],
      "properties": {
        "policy_id": {
          "$ref": "urn:ovpt:unleash:ipc-command:2#/$defs/model_policy_version_change/properties/policy_id"
        },
        "version": {
          "$ref": "urn:ovpt:unleash:ipc-command:2#/$defs/model_policy_version_change/properties/version"
        },
        "digest": { "type": "string", "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$" },
        "policy_version_ref": {
          "type": "string",
          "pattern": "^model-policy:[a-z0-9]+(?:[._-][a-z0-9]+)*:[1-9][0-9]*:sha256:[0-9a-f]{64}$",
          "not": { "pattern": "\\s" }
        },
        "allowed_profiles": {
          "$ref": "urn:ovpt:unleash:ipc-command:2#/$defs/model_policy_version_change/properties/allowed_profiles"
        },
        "allowed_capabilities": {
          "$ref": "urn:ovpt:unleash:ipc-command:2#/$defs/model_policy_version_change/properties/allowed_capabilities"
        },
        "fallback_profiles": {
          "$ref": "urn:ovpt:unleash:ipc-command:2#/$defs/model_policy_version_change/properties/fallback_profiles"
        },
        "limits": {
          "$ref": "urn:ovpt:unleash:ipc-command:2#/$defs/model_policy_version_change/properties/limits"
        },
        "principal_id": { "type": "string", "pattern": "\\S" },
        "command_receipt_id": { "$ref": "#/$defs/uuid" },
        "revocation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["principal_id", "command_receipt_id"],
          "properties": {
            "principal_id": { "type": "string", "pattern": "\\S" },
            "command_receipt_id": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    },
    "provider_profile_list_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profiles", "next_after_profile_id"],
          "properties": {
            "next_after_profile_id": {
              "anyOf": [
                { "$ref": "#/$defs/provider_profile_id" },
                { "type": "null" }
              ]
            },
            "profiles": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile_id", "profile_version", "profile_version_ref",
                  "provider_kind", "model", "qualification"
                ],
                "properties": {
                  "profile_id": { "$ref": "#/$defs/provider_profile_id" },
                  "profile_version": { "$ref": "#/$defs/wire_uint", "minimum": 1 },
                  "profile_version_ref": { "type": "string", "minLength": 1 },
                  "provider_kind": {
                    "enum": ["openai", "anthropic", "lmstudio", "ollama", "llama_cpp", "openai_compatible"]
                  },
                  "model": { "type": "string", "minLength": 1 },
                  "qualification": { "const": "required" }
                }
              }
            }
          }
        }
      }
    },
    "agent_projection_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_id", "project_id", "level", "state", "revision", "session_id",
            "organization_parent_id", "created_by_agent_id"
          ],
          "properties": {
            "agent_id": { "$ref": "#/$defs/uuid" },
            "project_id": { "$ref": "#/$defs/optional_uuid" },
            "level": { "enum": ["N", "N+1", "N+2"] },
            "state": { "enum": ["dormant", "eligible", "active", "blocked", "paused", "retired"] },
            "revision": { "$ref": "#/$defs/wire_uint" },
            "session_id": { "$ref": "#/$defs/optional_uuid" },
            "organization_parent_id": { "$ref": "#/$defs/optional_uuid" },
            "created_by_agent_id": { "$ref": "#/$defs/optional_uuid" }
          }
        }
      }
    },
    "invocation_attempt_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "ordinal", "state", "authority_generation", "daemon_epoch", "fence"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/uuid" },
        "ordinal": { "$ref": "#/$defs/wire_uint", "minimum": 1 },
        "state": { "enum": ["admitted", "running", "checkpointing", "reconciling", "ended", "failed", "fenced"] },
        "authority_generation": { "$ref": "#/$defs/uuid" },
        "daemon_epoch": { "$ref": "#/$defs/wire_uint" },
        "fence": { "$ref": "#/$defs/wire_uint" }
      }
    },
    "invocation_projection_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invocation_id", "agent_id", "session_id", "project_id", "state", "wait_reason",
            "revision", "effective_bundle_hash", "context_manifest_id", "attempts",
            "next_after_attempt_ordinal"
          ],
          "properties": {
            "invocation_id": { "$ref": "#/$defs/uuid" },
            "agent_id": { "$ref": "#/$defs/uuid" },
            "session_id": { "$ref": "#/$defs/uuid" },
            "project_id": { "$ref": "#/$defs/optional_uuid" },
            "state": { "enum": ["queued", "admitted", "running", "checkpointing", "waiting_durable", "reconciling", "completed", "failed", "cancelled"] },
            "wait_reason": { "enum": [null, "waiting_owner", "waiting_children", "authentication", "document_event", "budget", "timer"] },
            "revision": { "$ref": "#/$defs/wire_uint" },
            "effective_bundle_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "context_manifest_id": { "$ref": "#/$defs/uuid" },
            "attempts": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/invocation_attempt_projection" }
            },
            "next_after_attempt_ordinal": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      }
    },
    "terminal_release_history_response": {
      "$ref": "#",
      "required": [
        "watermark"
      ],
      "properties": {
        "watermark": {
          "type": "object"
        },
        "result": {
          "$ref": "#/$defs/terminal_release_history_result"
        }
      }
    },
    "terminal_release_history_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "receipt_id",
        "terminal_id",
        "process_run_uuid",
        "source_command_id",
        "source_receipt_id",
        "source_action_id",
        "source_dispatch_id",
        "source_evaluation_id",
        "result_ref",
        "source_intent_digest",
        "source_context_digest",
        "native_ack_digest",
        "observation_object_hash",
        "retirement_epoch",
        "retirement_fence",
        "inspected_by_epoch",
        "observed_at_ms",
        "inspected_by",
        "cursor"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "receipt_id": {
          "$ref": "#/$defs/uuid"
        },
        "terminal_id": {
          "$ref": "#/$defs/uuid"
        },
        "process_run_uuid": {
          "$ref": "#/$defs/uuid"
        },
        "source_command_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_receipt_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_action_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_dispatch_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_evaluation_id": {
          "$ref": "#/$defs/uuid"
        },
        "result_ref": {
          "type": "string",
          "pattern": "^terminal-release-history:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_context_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "native_ack_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "observation_object_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "retirement_epoch": {
          "$ref": "#/$defs/wire_uint"
        },
        "retirement_fence": {
          "$ref": "#/$defs/wire_uint"
        },
        "inspected_by_epoch": {
          "$ref": "#/$defs/wire_uint"
        },
        "observed_at_ms": {
          "$ref": "#/$defs/wire_uint"
        },
        "inspected_by": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "$ref": "#/properties/watermark",
          "type": "object"
        }
      }
    },
    "terminal_acquisition_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": { "$ref": "#/$defs/terminal_acquisition_result" }
      }
    },
    "terminal_acquisition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_id", "command_id", "result_ref",
        "authority_generation", "daemon_epoch", "terminal_id", "process_id",
        "process_run_uuid", "reused", "state", "lease_id", "fence",
        "lease_expires_at", "control_revision", "input_seq", "cursor"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "receipt_id": { "$ref": "#/$defs/uuid" },
        "command_id": { "$ref": "#/$defs/uuid" },
        "result_ref": {
          "type": "string",
          "pattern": "^terminal-(allocation|control):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]" }
        },
        "authority_generation": { "$ref": "#/$defs/uuid" },
        "daemon_epoch": { "$ref": "#/$defs/wire_uint" },
        "terminal_id": { "$ref": "#/$defs/uuid" },
        "process_id": { "$ref": "#/$defs/uuid" },
        "process_run_uuid": { "$ref": "#/$defs/uuid" },
        "reused": { "type": "boolean" },
        "state": { "enum": ["ready", "busy", "detached"] },
        "lease_id": { "$ref": "#/$defs/uuid" },
        "fence": { "$ref": "#/$defs/wire_uint", "minimum": 1 },
        "lease_expires_at": { "type": "integer" },
        "control_revision": { "$ref": "#/$defs/wire_uint" },
        "input_seq": { "$ref": "#/$defs/wire_uint" },
        "cursor": { "$ref": "#/properties/watermark", "type": "object" }
      },
      "if": { "properties": { "reused": { "const": true } } },
      "then": { "properties": { "result_ref": { "pattern": "^terminal-control:" } } },
      "else": { "properties": { "result_ref": { "pattern": "^terminal-allocation:" } } }
    }
  }
}
