{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:ipc-query-response:1",
  "title": "QueryResponse proposée",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "result"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "watermark": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "stream_id",
        "sequence"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Watermark transactionnel optionnel de la vue projetée (stream_id et sequence)."
    },
    "result": {
      "description": "Données ou objet de résultat de la requête."
    }
  }
}
