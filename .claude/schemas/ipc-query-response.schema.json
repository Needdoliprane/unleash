{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:ipc-query-response:1",
  "title": "QueryResponse proposée",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "result"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "watermark": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "stream_id",
        "sequence"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "description": "Watermark transactionnel optionnel de la vue projetée (stream_id et sequence)."
    },
    "result": {
      "description": "Données ou objet de résultat de la requête."
    }
  },
  "$defs": {
    "workflow_run_projection_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "project_id",
        "mission_id",
        "workflow_version_id",
        "definition_hash",
        "effective_bundle_hash",
        "state",
        "revision",
        "purpose",
        "plan"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "mission_id": {
          "type": "string",
          "format": "uuid"
        },
        "workflow_version_id": {
          "type": "string",
          "minLength": 1
        },
        "definition_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effective_bundle_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "prepared",
            "running",
            "paused",
            "blocked",
            "cancelling",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purpose": {
          "enum": [
            "operational",
            "evaluation"
          ]
        },
        "plan": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "uuid": { "type": "string", "format": "uuid" },
    "wire_uint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "optional_uuid": { "type": ["string", "null"], "format": "uuid" },
    "provider_profile_id": {
      "$ref": "#/$defs/uuid",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "provider_profile_list_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profiles", "next_after_profile_id"],
          "properties": {
            "next_after_profile_id": {
              "anyOf": [
                { "$ref": "#/$defs/provider_profile_id" },
                { "type": "null" }
              ]
            },
            "profiles": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile_id", "profile_version", "profile_version_ref",
                  "provider_kind", "model", "qualification"
                ],
                "properties": {
                  "profile_id": { "$ref": "#/$defs/provider_profile_id" },
                  "profile_version": { "$ref": "#/$defs/wire_uint", "minimum": 1 },
                  "profile_version_ref": { "type": "string", "minLength": 1 },
                  "provider_kind": {
                    "enum": ["openai", "anthropic", "lmstudio", "ollama", "llama_cpp", "openai_compatible"]
                  },
                  "model": { "type": "string", "minLength": 1 },
                  "qualification": { "const": "required" }
                }
              }
            }
          }
        }
      }
    },
    "agent_projection_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_id", "project_id", "level", "state", "revision", "session_id",
            "organization_parent_id", "created_by_agent_id"
          ],
          "properties": {
            "agent_id": { "$ref": "#/$defs/uuid" },
            "project_id": { "$ref": "#/$defs/optional_uuid" },
            "level": { "enum": ["N", "N+1", "N+2"] },
            "state": { "enum": ["dormant", "eligible", "active", "blocked", "paused", "retired"] },
            "revision": { "$ref": "#/$defs/wire_uint" },
            "session_id": { "$ref": "#/$defs/optional_uuid" },
            "organization_parent_id": { "$ref": "#/$defs/optional_uuid" },
            "created_by_agent_id": { "$ref": "#/$defs/optional_uuid" }
          }
        }
      }
    },
    "invocation_attempt_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "ordinal", "state", "authority_generation", "daemon_epoch", "fence"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/uuid" },
        "ordinal": { "$ref": "#/$defs/wire_uint", "minimum": 1 },
        "state": { "enum": ["admitted", "running", "checkpointing", "reconciling", "ended", "failed", "fenced"] },
        "authority_generation": { "$ref": "#/$defs/uuid" },
        "daemon_epoch": { "$ref": "#/$defs/wire_uint" },
        "fence": { "$ref": "#/$defs/wire_uint" }
      }
    },
    "invocation_projection_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invocation_id", "agent_id", "session_id", "project_id", "state", "wait_reason",
            "revision", "effective_bundle_hash", "context_manifest_id", "attempts",
            "next_after_attempt_ordinal"
          ],
          "properties": {
            "invocation_id": { "$ref": "#/$defs/uuid" },
            "agent_id": { "$ref": "#/$defs/uuid" },
            "session_id": { "$ref": "#/$defs/uuid" },
            "project_id": { "$ref": "#/$defs/optional_uuid" },
            "state": { "enum": ["queued", "admitted", "running", "checkpointing", "waiting_durable", "reconciling", "completed", "failed", "cancelled"] },
            "wait_reason": { "enum": [null, "waiting_owner", "waiting_children", "authentication", "document_event", "budget", "timer"] },
            "revision": { "$ref": "#/$defs/wire_uint" },
            "effective_bundle_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "context_manifest_id": { "$ref": "#/$defs/uuid" },
            "attempts": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/invocation_attempt_projection" }
            },
            "next_after_attempt_ordinal": { "type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      }
    },
    "terminal_release_history_response": {
      "$ref": "#",
      "required": [
        "watermark"
      ],
      "properties": {
        "watermark": {
          "type": "object"
        },
        "result": {
          "$ref": "#/$defs/terminal_release_history_result"
        }
      }
    },
    "terminal_release_history_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "command_id",
        "receipt_id",
        "terminal_id",
        "process_run_uuid",
        "source_command_id",
        "source_receipt_id",
        "source_action_id",
        "source_dispatch_id",
        "source_evaluation_id",
        "result_ref",
        "source_intent_digest",
        "source_context_digest",
        "native_ack_digest",
        "observation_object_hash",
        "retirement_epoch",
        "retirement_fence",
        "inspected_by_epoch",
        "observed_at_ms",
        "inspected_by",
        "cursor"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "receipt_id": {
          "$ref": "#/$defs/uuid"
        },
        "terminal_id": {
          "$ref": "#/$defs/uuid"
        },
        "process_run_uuid": {
          "$ref": "#/$defs/uuid"
        },
        "source_command_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_receipt_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_action_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_dispatch_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_evaluation_id": {
          "$ref": "#/$defs/uuid"
        },
        "result_ref": {
          "type": "string",
          "pattern": "^terminal-release-history:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_context_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "native_ack_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "observation_object_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "retirement_epoch": {
          "$ref": "#/$defs/wire_uint"
        },
        "retirement_fence": {
          "$ref": "#/$defs/wire_uint"
        },
        "inspected_by_epoch": {
          "$ref": "#/$defs/wire_uint"
        },
        "observed_at_ms": {
          "$ref": "#/$defs/wire_uint"
        },
        "inspected_by": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "$ref": "#/properties/watermark",
          "type": "object"
        }
      }
    },
    "terminal_acquisition_response": {
      "$ref": "#",
      "required": ["watermark"],
      "properties": {
        "watermark": { "type": "object" },
        "result": { "$ref": "#/$defs/terminal_acquisition_result" }
      }
    },
    "terminal_acquisition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_id", "command_id", "result_ref",
        "authority_generation", "daemon_epoch", "terminal_id", "process_id",
        "process_run_uuid", "reused", "state", "lease_id", "fence",
        "lease_expires_at", "control_revision", "input_seq", "cursor"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "receipt_id": { "$ref": "#/$defs/uuid" },
        "command_id": { "$ref": "#/$defs/uuid" },
        "result_ref": {
          "type": "string",
          "pattern": "^terminal-(allocation|control):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]" }
        },
        "authority_generation": { "$ref": "#/$defs/uuid" },
        "daemon_epoch": { "$ref": "#/$defs/wire_uint" },
        "terminal_id": { "$ref": "#/$defs/uuid" },
        "process_id": { "$ref": "#/$defs/uuid" },
        "process_run_uuid": { "$ref": "#/$defs/uuid" },
        "reused": { "type": "boolean" },
        "state": { "enum": ["ready", "busy", "detached"] },
        "lease_id": { "$ref": "#/$defs/uuid" },
        "fence": { "$ref": "#/$defs/wire_uint", "minimum": 1 },
        "lease_expires_at": { "type": "integer" },
        "control_revision": { "$ref": "#/$defs/wire_uint" },
        "input_seq": { "$ref": "#/$defs/wire_uint" },
        "cursor": { "$ref": "#/properties/watermark", "type": "object" }
      },
      "if": { "properties": { "reused": { "const": true } } },
      "then": { "properties": { "result_ref": { "pattern": "^terminal-control:" } } },
      "else": { "properties": { "result_ref": { "pattern": "^terminal-allocation:" } } }
    }
  }
}
