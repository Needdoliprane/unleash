{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:automation-observation:v1",
  "title": "Automation ObservationReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "step_activation_id",
    "observed_revision",
    "outcome",
    "safe_to_continue",
    "effect_state",
    "reason",
    "action_refs",
    "assertion_refs",
    "log_refs",
    "capture_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "unleash.automation-observation.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "step_activation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observed_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "enum": [
        "observed",
        "expected_failure",
        "unknown"
      ]
    },
    "safe_to_continue": {
      "type": "boolean"
    },
    "effect_state": {
      "enum": [
        "none",
        "known",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "action_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 4096
    },
    "assertion_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 4096
    },
    "log_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 4096
    },
    "capture_limits": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effect_state": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "safe_to_continue": {
            "const": false
          },
          "outcome": {
            "const": "unknown"
          },
          "action_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "unknown",
              "expected_failure"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "safe_to_continue": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect_state": {
            "const": "known"
          }
        }
      },
      "then": {
        "properties": {
          "action_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
