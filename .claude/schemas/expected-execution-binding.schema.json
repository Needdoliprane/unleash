{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "contract_ref",
    "rule_ids",
    "expectation_slot",
    "expectation_ref",
    "subject",
    "activation_ref",
    "action_id",
    "sealed_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": "unleash.expected-execution-binding.v1"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract_ref": {
      "$ref": "urn:ovpt:unleash:expected-test-execution:1#/$defs/exact_ref"
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "expectation_slot": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "expectation_ref": {
      "$ref": "urn:ovpt:unleash:expected-test-execution:1#/$defs/exact_ref"
    },
    "subject": {
      "$ref": "urn:ovpt:unleash:expected-test-execution:1#/$defs/subject"
    },
    "activation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sealed_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "sequence"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:expected-execution-binding:1",
  "title": "ExpectedExecutionBinding V1 — scellement serveur avant effet",
  "$comment": "Objet persistant créé par le harness, pas payload autorisant le client à choisir une provenance. Le domaine vérifie autorité/FKs/digests et ordre sealed < dispatch < observation. La sélection courante de tentative vient de la révision autoritaire de l’activation."
}
