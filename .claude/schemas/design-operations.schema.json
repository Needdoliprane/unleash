{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:design:operations:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "unleash.design.operations.v1"
    },
    "package_id": {
      "const": "ovpt.unleash.v1"
    },
    "revision": {
      "type": "string",
      "pattern": "^R[0-9]+$"
    },
    "purpose": {
      "const": "design_only"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]+$"
          },
          "kind": {
            "enum": [
              "command",
              "query",
              "stream",
              "handshake"
            ]
          },
          "owner_features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^F\\d{3}$"
            },
            "uniqueItems": true
          },
          "status": {
            "const": "proposed"
          },
          "contract_stage": {
            "const": "documented"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "contract_source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "subject": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "subject"
            ]
          },
          "payload_schema_ref": {
            "type": "null"
          },
          "runtime_executable": {
            "const": false
          },
          "parity_group_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "kind",
          "owner_features",
          "status",
          "contract_stage",
          "description",
          "contract_source",
          "payload_schema_ref",
          "runtime_executable",
          "parity_group_ids"
        ]
      }
    },
    "parity_groups": {
      "type": "array",
      "minItems": 58,
      "maxItems": 58,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PAR-[A-Z]+-\\d{2}$"
          },
          "status": {
            "const": "required_not_tested"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "operation_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "subject": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "subject"
            ]
          },
          "local_presentation_actions": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "statement",
          "operation_names",
          "source",
          "local_presentation_actions"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "revision",
    "purpose",
    "operations",
    "parity_groups"
  ]
}
