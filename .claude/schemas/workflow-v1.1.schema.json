        "max_cost_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_agent_executions": {
          "description": "Nombre maximal d'invocations agentes simultanément actives du run : sous-plafond de concurrence soumis au pool global ; le cumul est borné par max_step_activations et max_llm_calls.",
