        "until",
        "max_iterations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "kind": {
          "const": "repeat"
        },
        "body": {
          "$ref": "#/$defs/machine_node"
        },
        "until": {
          "$ref": "#/$defs/guard"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "machine_fail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "code",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "kind": {
          "const": "fail"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "maxLength": 96
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "machine_node": {
      "oneOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "$ref": "#/$defs/machine_sequence"
        },
        {
          "$ref": "#/$defs/machine_parallel"
        },
        {
          "$ref": "#/$defs/machine_choice"
        },
        {
          "$ref": "#/$defs/machine_repeat"
        },
        {
          "$ref": "#/$defs/machine_fail"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_policy": {
            "const": "forbidden"
          }
        },
        "required": [
          "model_policy"
        ]
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/machine_node"
          },
          "budget": {
            "properties": {
              "max_llm_calls": {
                "const": 0
              },
              "max_output_tokens": {
                "const": 0
              },
              "max_cost_microusd": {
                "const": 0
              },
              "max_agent_executions": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
