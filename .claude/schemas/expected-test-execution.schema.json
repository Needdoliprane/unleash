{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expectation_id",
    "version",
    "authority_ref",
    "subject",
    "command",
    "result_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "unleash.expected-test-execution.v1"
    },
    "expectation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authority_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "contract",
            "execution_plan",
            "mission_mandate"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "command": {
      "$ref": "#/$defs/command"
    },
    "result_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_exit_code",
        "min_cases",
        "require_all_passed"
      ],
      "properties": {
        "expected_exit_code": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "min_cases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "require_all_passed": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ovpt:unleash:expected-test-execution:1",
  "title": "ExpectedTestExecution V1 — attente autoritaire matérialisée avant effet",
  "$comment": "Forme seule : autorité, scellement avant dispatch, sélection de tentative et résolution des snapshots sont vérifiés par le domaine. Références locales uniquement. snapshot_ref.kind : git_tree désigne un git_snapshot à capture_consistency=git_tree_coherent ; source_snapshot toute autre entrée de source_snapshots (Git dirty, file_snapshot, resource_snapshot) ; data_snapshot une AutomationDataRevision. id est le version_id résolu et sha256 le digest SHA-256 du manifeste canonique de cette version, jamais un OID Git.",
  "$defs": {
    "exact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_revision",
        "scope_id",
        "scope_revision",
        "snapshot_ref"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "snapshot_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "sha256"
          ],
          "properties": {
            "kind": {
              "enum": [
                "git_tree",
                "source_snapshot",
                "data_snapshot"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_ref",
        "argv_sha256",
        "cwd_resource_id",
        "environment_profile_ref",
        "environment_sha256",
        "suite_ref",
        "parser_ref"
      ],
      "properties": {
        "tool_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "argv_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cwd_resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment_profile_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "suite_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "parser_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  }
}
