{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OVPT Unleash",
  "version": "0.1.0",
  "identifier": "org.ovpt.unleash",
  "build": {
    "frontendDist": "../../apps/gui-renderer/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OVPT Unleash",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": false
  }
}
