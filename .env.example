# Modèle de .env pour le développement d'Unleash. Copier en .env (ignoré par Git) et renseigner.
# Les tests live chargent .env eux-mêmes (dotenvy) ; ne jamais l'afficher ni le committer.

UNLEASH_DEV_ANTHROPIC_API_KEY=
UNLEASH_DEV_OPENAI_API_KEY=

# Tests payants réels : désactivés par défaut ; activer (=1) seulement pour une campagne live explicite.
UNLEASH_LIVE_TESTS=0
# Seuls modèles autorisés pour les tests payants pendant le développement (modèles faibles uniquement).
UNLEASH_LIVE_TEST_MODEL_ALLOWLIST=claude-haiku-5-5,gpt-6-luna
UNLEASH_LIVE_TEST_ANTHROPIC_MODEL=claude-haiku-5-5
UNLEASH_LIVE_TEST_OPENAI_MODEL=gpt-6-luna
# Plafond de dépense par campagne de tests live, en USD (le testkit refuse au-delà).
UNLEASH_LIVE_TEST_BUDGET_USD=5
